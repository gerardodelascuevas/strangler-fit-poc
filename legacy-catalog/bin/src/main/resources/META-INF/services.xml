<?xml version="1.0" encoding="UTF-8"?>
<serviceGroup>
    <service name="ProductCatalogService">
        <description>Legacy Product Catalog SOAP Service - version 1.0</description>
        <parameter name="ServiceClass" locked="false">
            com.legacy.catalog.service.ProductCatalogService
        </parameter>
        <parameter name="loadOnStartup">true</parameter>
        <messageReceivers>
            <messageReceiver mep="http://www.w3.org/ns/wsdl/in-out"
                             class="org.apache.axis2.rpc.receivers.RPCMessageReceiver"/>
        </messageReceivers>
        <operation name="getAllProducts"/>
        <operation name="getProduct"/>
        <operation name="createProduct"/>
        <operation name="updateProduct"/>
        <operation name="deleteProduct"/>
        <operation name="searchProducts"/>
        <operation name="getInventoryReport"/>
    </service>
</serviceGroup>
